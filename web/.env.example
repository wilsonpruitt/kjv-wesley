# Patreon OAuth credentials. Use the History of Methodism client.
# Add https://kjv.wrootpress.com/api/auth/callback (and localhost in dev) to the
# client's redirect-URI list in Patreon's developer portal.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# Long random string for signing session cookies. Regenerate per environment.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Minimum Patreon pledge (cents) required to unlock gated books.
MIN_PLEDGE_CENTS=500

# Owner-bypass token. Hit /api/admin/unlock?token=... to flip an admin flag in
# the session cookie. Keep it long and unguessable.
ADMIN_TOKEN=
